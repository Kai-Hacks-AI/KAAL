{
  "name": "kaal-engineering",
  "private": true,
  "description": "Engineering repository for KAAL. The distributable packages are under packages/.",
  "type": "module",
  "workspaces": [
    "packages/kaal-core",
    "packages/extensions/kaal-hosting"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "test:acceptance": "node --test engineering/acceptance/embed.test.mjs",
    "pack": "npm pack -w kaal-core --pack-destination engineering/out"
  },
  "engines": {
    "node": ">=20.1"
  }
}
