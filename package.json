{
  "name": "kaal",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:kaal-core && npm run test:kaal-agent && npm run test:engineering-kaal-skill && npm run test:changing-kaal && npm run test:kaal-install && npm run test:change-seal",
    "test:kaal-core": "npm test --prefix engineering/kaal-core",
    "test:kaal-agent": "npm test --prefix engineering/kaal-agent",
    "test:engineering-kaal-skill": "npm test --prefix engineering/engineering-kaal-skill",
    "test:changing-kaal": "npm test --prefix engineering/changing-kaal",
    "test:kaal-install": "npm test --prefix engineering/kaal-install",
    "test:change-seal": "npm test --prefix engineering/change-seal",
    "install-kaal": "npm run build --prefix engineering/kaal-install && node engineering/kaal-install/dist/helpers/install-kaal.js",
    "check-kaal-install": "npm run build --prefix engineering/kaal-install && node engineering/kaal-install/dist/helpers/check-kaal-install.js",
    "seal-kaal-change": "npm run build --prefix engineering/change-seal && node engineering/change-seal/dist/helpers/cli.js seal .kaal",
    "list-sealed-changes": "npm run build --prefix engineering/change-seal && node engineering/change-seal/dist/helpers/cli.js closed",
    "check-kaal-changes": "npm run build --prefix engineering/change-seal && node engineering/change-seal/dist/helpers/cli.js check .kaal",
    "check-kaal-seals": "npm run check-kaal-seals --prefix engineering/kaal-core",
    "seal-kaal-artifact": "npm run seal-kaal-artifact --prefix engineering/kaal-core --",
    "wire-kaal-agent": "npm run build --prefix engineering/kaal-agent && node engineering/kaal-agent/dist/helpers/wire-kaal-agent.js",
    "check-kaal-agent": "npm run build --prefix engineering/kaal-agent && node engineering/kaal-agent/dist/helpers/check-kaal-agent.js",
    "prepare": "git config core.hooksPath .githooks || true",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=20" }
}
