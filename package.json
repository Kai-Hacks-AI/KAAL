{
  "name": "kaal",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:kaal-core",
    "test:kaal-core": "npm test --prefix engineering/kaal-core",
    "check-kaal-seals": "npm run check-kaal-seals --prefix engineering/kaal-core",
    "seal-kaal-artifact": "npm run seal-kaal-artifact --prefix engineering/kaal-core --",
    "prepare": "git config core.hooksPath .githooks || true",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=20" }
}
