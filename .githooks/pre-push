#!/bin/sh
# Early local feedback before a push, from the same KAAL checkers CI runs. For each pushed ref this
# hook resolves the pull request target (KAAL's branching policy, below) and runs KAAL's hook checks
# through kaal-guard, giving it the Git facts. KAAL declares those checks in .kaal/config/guard/; today
# that is push, KAAL's branching and Change Isolation judgment (engineering/github/push-check.sh),
# whose rules, verdicts and guidance live in engineering/github/lineage.ts,
# engineering/change-isolation/check.mjs and engineering/github/branching.md. CI stays the authority.
#
# Enable once per clone: git config core.hooksPath .githooks
# Target: the pull request base a branch is meant for, named once per branch:
#   git config branch.<branch>.kaalTarget origin/kaal/<lineage>
# A kaal/* branch without one targets the default branch, its promotion. Any other branch without
# one is not verified until its target is named. Judged against your last fetch; skip once with
# git push --no-verify.
remote=${1:-origin}
default_ref=$(git symbolic-ref --quiet --short "refs/remotes/$remote/HEAD" 2>/dev/null || echo "$remote/main")
guide=engineering/github/branching.md
guard=node_modules/.bin/kaal-guard # installed by npm ci from packages/kaal-guard; the call below names it in full
status=0
say() { echo "$*" >&2; }
fail() { say "$*"; status=1; }
if [ ! -x "$guard" ]; then
  say "Not verified: kaal-guard is not installed in this clone. Run npm ci, then push again."
  say "Local feedback only; CI decides. Skip once with git push --no-verify."
  exit 1
fi
while read -r local_ref head remote_ref remote_head; do
  case $head in *[!0]*) ;; *) continue ;; esac # a deleted ref carries no change
  branch=${local_ref#refs/heads/}
  target=
  [ "$branch" != "$local_ref" ] && target=$(git config "branch.$branch.kaalTarget")
  if [ -z "$target" ]; then
    case $branch in
      kaal/*) target=$default_ref ;; # a lineage's only pull request is its promotion
      *)
        if [ "$branch" != "$local_ref" ]; then
          fail "Not verified: $local_ref has no named pull request target. Name the lineage it is meant for:"
          say "  git config branch.$branch.kaalTarget $remote/kaal/<lineage>   See $guide#engineer"
        else
          fail "Not verified: $local_ref is not a branch, so it has no pull request target. Push it from a branch and name that branch's target. See $guide"
        fi
        continue ;;
    esac
  fi
  if ! base=$(git rev-parse --quiet --verify "$target^{commit}"); then
    fail "Not verified: target $target of $local_ref is not known here. Fetch it, or name an existing ref in branch.$branch.kaalTarget."
    continue
  fi
  say "$local_ref -> ${target#"$remote/"} (base $base):"
  KAAL_PUSH_REMOTE=$remote KAAL_PUSH_REF=$local_ref KAAL_PUSH_REMOTE_HEAD=$remote_head \
    node_modules/.bin/kaal-guard run --hook --head "$head" --base "$base" --base-ref "$target" </dev/null >&2 \
    || status=1
done
[ $status = 0 ] || say "Local feedback only; CI decides. Fix and push again, or skip once with git push --no-verify."
exit $status
