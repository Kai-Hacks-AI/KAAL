{
  "name": "kaal-core",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && tsc -p test/tsconfig.json && node --test dist-test/test/*.test.js && tsc -p acceptance/tsconfig.json && node --test dist-test/acceptance/*.test.js",
    "clean": "rm -rf dist dist-test",
    "check-kaal-kernel": "npm test",
    "seal-kaal-kernel": "tsc -p test/tsconfig.json && node dist-test/src/engineering/write-seal.js"
  }
}
