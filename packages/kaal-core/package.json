{
  "name": "kaal-core",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/seal.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p test/tsconfig.json && node --test dist-test/test/*.test.js",
    "clean": "rm -rf dist dist-test",
    "check-kaal-kernel": "npm test",
    "seal-kaal-kernel": "tsc -p tsconfig.json && node dist/seal.js"
  }
}
