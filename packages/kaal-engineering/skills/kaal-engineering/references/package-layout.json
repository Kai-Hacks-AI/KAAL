{
  "places": [
    "packages/<capability>",
    "engineering/<capability>",
    ".kaal/<capability>"
  ],
  "root": [
    {
      "name": "AGENTS.md",
      "kind": "machinery",
      "bass": "Bare to Agent",
      "required": true
    },
    {
      "name": "README.md",
      "kind": "machinery",
      "required": true
    },
    {
      "name": "LICENSE",
      "kind": "machinery"
    },
    {
      "name": "package.json",
      "kind": "machinery",
      "required": true
    },
    {
      "name": "*.kaal.json",
      "kind": "machinery"
    }
  ],
  "folders": [
    {
      "name": "00-backlog",
      "kind": "content",
      "role": "what we might do"
    },
    {
      "name": "01-changes",
      "kind": "content",
      "role": "in flight, temporary"
    },
    {
      "name": "02-learnings",
      "kind": "content",
      "role": "what we learned: the retrospectives of the package's collectors, the research notes on what is out there, the rehearsals of our own ideas, and the targeted reviews worth keeping, kept with the capability",
      "closed": true,
      "children": [
        "retros",
        "research",
        "rehearsals",
        "reviews"
      ],
      "retros": "per-collector retrospectives, each with front matter `reflects: [C…]`; the object belongs to kaal-retro, which also says what verifies one",
      "research": "research notes on external references, each with an id `R<n>`, asked by this capability; the object belongs to kaal-research, which also says what verifies one and what sits beside it",
      "rehearsals": "rehearsals of this capability's own ideas, each run and observed, id `RH<n>`; the object belongs to kaal-research (its second Skill), which also says what verifies one and what evidence sits beside it",
      "reviews": "targeted reviews deemed worth persisting, id `RV<n>`, not every review; the object belongs to kaal-review, which also decides what is worthy and what verifies one"
    },
    {
      "name": "10-intent",
      "kind": "content",
      "element": "intent",
      "children": [
        "intent",
        "test-cases",
        "review-items"
      ],
      "verifiedBy": "test-cases",
      "required": true
    },
    {
      "name": "11-requirements",
      "kind": "content",
      "element": "requirement",
      "children": [
        "requirements",
        "test-cases",
        "review-items"
      ],
      "verifiedBy": "test-cases",
      "required": true
    },
    {
      "name": "12-architecture",
      "kind": "content",
      "element": "architecture",
      "children": [
        "architecture",
        "test-cases",
        "review-items"
      ],
      "verifiedBy": "test-cases",
      "required": true
    },
    {
      "name": "13-source",
      "kind": "machinery",
      "children": [
        "skill",
        "scripts",
        "unit-tests",
        "workflows",
        "review-items"
      ],
      "bass": {
        "skill": "Agent to Skill",
        "scripts": "Skill to Script"
      },
      "verifiedBy": "unit-tests",
      "closed": true,
      "required": true
    },
    {
      "name": "14-operations",
      "kind": "content",
      "element": "operation",
      "role": "execution and observation: where the package is run and what that shows",
      "closed": true,
      "children": [
        "controls",
        "runs",
        "review-items"
      ],
      "optional": [
        "runs",
        "review-items"
      ],
      "controls": {
        "role": "controls over the package itself",
        "scope": "package",
        "covers": [
          "development",
          "delivery",
          "solution"
        ]
      },
      "runs": "fallback records, judged and stamped, only where evidence cannot be re-run or re-derived",
      "verifiedBy": "controls",
      "required": true
    },
    {
      "name": "15-defects",
      "kind": "content",
      "element": "defect",
      "children": [
        "defects",
        "test-cases",
        "review-items"
      ],
      "verifiedBy": "test-cases"
    },
    {
      "name": "dist",
      "kind": "machinery",
      "generated": true,
      "committed": false,
      "from": "13-source"
    }
  ],
  "deterministic": [
    "scripts",
    "unit-tests",
    "test-cases"
  ],
  "consumerSpace": [
    "controls over how a consumer runs its own repository"
  ],
  "deployment": {
    "packages/<capability>": {
      "machinery": "written here, only here",
      "content": "the capability's own"
    },
    "engineering/<capability>": {
      "machinery": "deployed from N+1",
      "content": "the consumer's, produced by the capability"
    },
    ".kaal/<capability>": {
      "machinery": "deployed from N through npmjs",
      "content": "the consumer's, produced by the capability"
    }
  },
  "rules": {
    "numbersOrderOnly": true,
    "contentIsLocal": true,
    "contentIsNeverDeployed": true,
    "contentIsNeverCompared": true,
    "deployedMachineryMatchesSource": true
  },
  "controls": {
    "ownedBy": "consumer",
    "linksTo": "intent",
    "findsMachineryThrough": [
      "intent",
      "requirements",
      "architecture"
    ],
    "shippedByCapability": false,
    "capabilityShips": [
      "solution elements",
      "machinery"
    ],
    "consumerOwns": [
      "control",
      "evidence",
      "operational state"
    ],
    "packageControls": "govern the package itself, and sit in 14-operations/controls"
  },
  "agents": [
    {
      "path": "AGENTS.md",
      "serves": "work across the repository",
      "ships": false,
      "verifiedBy": "review"
    },
    {
      "path": "packages/AGENTS.md",
      "serves": "work across packages",
      "ships": false,
      "verifiedBy": "review"
    },
    {
      "path": "<place>/<capability>/AGENTS.md",
      "serves": "work on this package",
      "ships": false,
      "verifiedBy": "review"
    },
    {
      "path": "<place>/<capability>/dist/AGENTS.md",
      "serves": "consumers using the capability",
      "ships": true,
      "verifiedBy": "build",
      "from": "13-source",
      "bass": "Bare to Agent",
      "pointsTo": "skills/<name>/SKILL.md",
      "repeatsSkill": false
    }
  ]
}
