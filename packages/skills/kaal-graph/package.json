{
  "name": "@kaihacksai/kaal-graph",
  "version": "0.0.1",
  "description": "KAAL Graph: a Node's Form and identity, the Edges embedded in Nodes, their checks, derived indexes, lookup and traversal.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./skills/kaal-graph/scripts/edges.d.ts",
      "default": "./skills/kaal-graph/scripts/edges.mjs"
    },
    "./form": {
      "types": "./skills/kaal-graph/scripts/form.d.ts",
      "default": "./skills/kaal-graph/scripts/form.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kaal-graph": "skills/kaal-graph/scripts/graph.mjs"
  },
  "files": [
    "docs",
    "payload",
    "skills",
    "test/embedded",
    "test/verify.mjs",
    "test/verify.json"
  ],
  "scripts": {
    "test": "node test/verify.mjs",
    "test:publisher": "node --test \"test/publisher/*.test.mjs\" && node --test --test-name-pattern=\"^graph/T(8|9|1[0-24-5]) \" test/plan/release.test.mjs && node test/verify.mjs",
    "manifest": "node test/publisher/manifest.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@kaihacksai/kaal-hosting": "0.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "kaal-engineer-skill": "0.0.1",
    "kaal-testing": "0.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kai-Hacks-AI/KAAL.git",
    "directory": "packages/skills/kaal-graph"
  },
  "publishConfig": {
    "access": "public"
  }
}
