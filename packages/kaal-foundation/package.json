{
  "name": "@kaihacksai/kaal-foundation",
  "version": "0.0.2",
  "description": "KAAL Foundation: the shared, dependency-free primitives every KAAL Capability may build on.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kai-Hacks-AI/KAAL.git",
    "directory": "packages/kaal-foundation"
  },
  "type": "module",
  "bin": {
    "kaal-foundation": "dist/skills/kaal-foundation/scripts/kaal-foundation.mjs"
  },
  "exports": {
    "./sha256": {
      "types": "./dist/skills/kaal-foundation/scripts/sha256.d.ts",
      "default": "./dist/skills/kaal-foundation/scripts/sha256.mjs"
    },
    "./capability": "./dist/kaal/Foundation.md",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node 04-test/engineering-check/build.mjs",
    "pretest": "node -e \"if(require('fs').existsSync('04-test')){require('child_process').execFileSync(process.execPath,['04-test/engineering-check/build.mjs'],{stdio:'inherit'})}\"",
    "test": "node dist/test/package-check/verify.mjs",
    "test:publisher": "npm run build && node 04-test/engineering-check/collect.mjs",
    "manifest": "npm run build && node 04-test/engineering-check/publisher/manifest.mjs && npm run build",
    "prepack": "node 04-test/engineering-check/build.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
