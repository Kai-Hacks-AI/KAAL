{
  "name": "@kaihacksai/kaal-foundation",
  "version": "0.0.1",
  "description": "KAAL Foundation: the shared, dependency-free primitives every KAAL Capability may build on.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./sha256": {
      "types": "./lib/sha256.d.ts",
      "default": "./lib/sha256.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "test/consumer",
    "test/verify.mjs",
    "test/run.mjs"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "test:consumer": "node test/verify.mjs",
    "test:publisher": "node --test test/plan/sha256.test.mjs test/plan/publication.test.mjs"
  },
  "engines": {
    "node": ">=24"
  }
}
