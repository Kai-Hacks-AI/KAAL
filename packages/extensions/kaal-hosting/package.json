{
  "name": "@kaihacksai/kaal-hosting",
  "version": "0.0.1",
  "description": "KAAL Hosting: the host-facing KAAL Extension. It provides the filesystem operations and guarantees KAAL needs on Linux, Windows and macOS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kai-Hacks-AI/KAAL.git",
    "directory": "packages/extensions/kaal-hosting"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "payload"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "test": "npm run build && node -e \"require('fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test dist-test/hosting.test.js dist-test/conformance.test.js test/plan/reconciliation.test.mjs test/plan/cleanup.test.mjs test/plan/kinds.test.mjs test/plan/expectations.test.mjs",
    "test:plan": "npm run build && node --test test/plan/release.test.mjs",
    "prepack": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "es-module-lexer": "^3.0.3",
    "graceful-fs": "^4.2.11",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/graceful-fs": "^4.1.9",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
